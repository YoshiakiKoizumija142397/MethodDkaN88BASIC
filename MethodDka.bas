100 REM 高次代数方程式
110 REM DKA法の修正版
130 PRINT "DKA法の修正版"
140 PRINT "次数:"
150 INPUT N
160 DIM SA(N), SR(N), SI(N)
170 FOR I = 0 TO N
180 PRINT "係数A("; N - I; ")="
190 INPUT SA(I)
200 NEXT I
210 IF SA(0) = 0 THEN STOP
220 REM 高次代数方程式
230 GOSUB 1010
240 PRINT
250 PRINT "解"
260 PRINT
270 PRINT "番号  実数部  虚数部"
280 FOR I = 1 TO N
290 PRINT I; SR(I); SI(I)
300 NEXT I
310 END

1000 REM 高次代数方程式DKA法修正版サブルーチン
1010 DIM SX(N), SY(N)
1020 SE = 0.0000001
1030 M = 100
1040 SP = 3.1415926535
1050 SW = 0
1060 FOR I = 1 TO N
1070 SA(I) = SA(I) / SA(0)
1080 NEXT I
1090 FOR I = 2 TO N
1100 SQ = N * (ABS(SA(I))) ^ (1 / I)
1110 IF SW < SQ THEN SW = SQ
1120 NEXT I
1130 SB = 2 * SP / N
1140 SC = SP / (2 * N)
1150 FOR J = 1 TO N
1160 ST = SB * (J - 1) + SC
1170 SR(J) = SW * COS(ST)
1180 SI(J) = SW * SIN(ST)
1190 NEXT J
1200 FOR K = 1 TO M
1210 FOR I = 1 TO N
1220 S1 = 1
1230 S2 = 0
1240 S3 = 1
1250 S4 = 0
1260 SB = SR(I)
1270 SC = SI(I)
1280 FOR J = 1 TO N
1290 S5 = S1 * SB - S2 * SC
1300 S2 = S1 * SC + S2 * SB
1310 S1 = S5
1320 IF J = I THEN 1360
1330 S5 = S3 * (SB - SR(J)) - S4 * (SC - SI(J))
1340 S4 = S3 * (SC - SI(J)) + S4 * (SB - SR(J))
1350 S3 = S5
1360 NEXT J
1370 SW = S3 * S3 + S4 * S4
1380 SX(I) = (S1 * S3 + S2 * S4) / SW
1390 SY(I) = (S2 * S3 - S1 * S4) / SW
1400 NEXT I
1410 FOR I = 1 TO N
1420 SR(I) = SR(I) - SX(I)
1430 SI(I) = SI(I) - SY(I)
1440 NEXT I
1450 FOR I = 1 TO N
1460 IF ABS(SX(I)) > SE THEN 1500
1470 IF ABS(SY(I)) > SE THEN 1500
1480 NEXT I
1490 RETURN
1500 NEXT K
1510 PRINT
1520 PRINT "NON CONVERGENCE"
1530 STOP
1540 END
